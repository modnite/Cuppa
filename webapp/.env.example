# Copy to .env and adjust, then: docker compose up -d

# Timezone for job timestamps.
TZ=America/New_York

# Web UI port (host networking, so this is a port on the NAS itself).
CUPPA_WEB_PORT=8631

# IPP port clients print to. 631 is the standard; change only if it is taken.
CUPPA_IPP_PORT=631

# Optional admin password, applied on first start. Leave empty for no login.
CUPPA_ADMIN_PASSWORD=
