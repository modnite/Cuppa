<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Only offer Cuppa for actual printers. This used to include class 0 (per-interface), class
        255 (vendor-specific), and a catch-all <usb-device />, which made Android offer Cuppa for
        every USB device that was plugged in (audio adapters, game controllers, Ethernet dongles)
        and made Cuppa prompt for permission on all of them.
    -->

    <!-- Standard USB Printer Class -->
    <usb-device class="7" />

    <!-- Rollo X1038 as it actually enumerates (VID 0x09C5 = 2501, PID 0x0588 = 1416) -->
    <usb-device vendor-id="2501" product-id="1416" />

    <!-- Other Rollo/thermal label printers: STMicroelectronics-based (VID 0x0483 = 1155) -->
    <usb-device vendor-id="1155" product-id="22304" />
</resources>
